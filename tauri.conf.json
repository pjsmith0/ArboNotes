{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArboNotes",
  "version": "1.0.0",
  "identifier": "com.pjs.arbonotes",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ArboNotes",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Hierarchical notes with rich text editing",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
